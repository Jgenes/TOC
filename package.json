{
  "name": "toc-investment-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "setup:staff": "node scripts/setup-staff.mjs",
    "export:portable": "node scripts/export-portable.mjs",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.ts\" \"portable/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,mts}\" \"tests/**/*.ts\"",
    "setup:accounts": "tsx scripts/setup-accounts.mts",
    "jobs:run": "tsx scripts/process-jobs.mts",
    "backup:verify": "tsx scripts/backup.mts",
    "test:browser": "node scripts/blueprint-browser-check.mjs",
    "test:browser:prepare": "tsx scripts/browser-fixtures.mts",
    "preview:qa": "node scripts/start-qa-preview.mjs",
    "docs:api": "tsx scripts/generate-openapi.mts",
    "ops:check": "tsx scripts/check-operations.mts",
    "test:portable": "node scripts/portable-browser-check.mjs",
    "docs:coverage": "tsx scripts/generate-coverage.mts"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.6",
    "lucide-react": "^0.468.0",
    "next": "^16.4.6",
    "nodemailer": "^10.6.0",
    "pdfkit": "^0.20.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.7.2"
  }
}
