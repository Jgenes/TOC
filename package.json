{
  "name": "toc-investment-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "setup:staff": "node scripts/setup-staff.mjs",
    "export:portable": "node scripts/export-portable.mjs",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.ts\" \"portable/**/*.{ts,tsx}\" \"scripts/*.mjs\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "better-sqlite3": "^12.4.6",
    "lucide-react": "^0.468.0",
    "next": "^16.4.6",
    "nodemailer": "^10.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.7.2"
  }
}
