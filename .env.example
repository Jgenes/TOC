# Keep true until TOC signs off content, security, privacy and operations.
# This flag must match at BUILD TIME and runtime; rebuild after changing it.
NEXT_PUBLIC_PREVIEW_MODE=true
# Required for production account links, canonical metadata and sitemap.
# Use the management-approved HTTPS origin, with no trailing slash.
# NEXT_PUBLIC_SITE_URL=https://approved-company-domain

# Server-only random secret: at least 32 characters. Back up securely.
# Encrypts staff TOTP secrets; losing/changing it requires MFA recovery.
SESSION_SECRET=
# Single persistent Node instance. These paths must be private and persistent.
DATABASE_PATH=./data/toc.sqlite
PRIVATE_STORAGE_PATH=./data/private-documents

# Initial individual administrator: npm run setup:accounts.
# Production requires a verified, company-controlled email.
TOC_BOOTSTRAP_EMAIL=
TOC_BOOTSTRAP_NAME=TOC administrator
TOC_BOOTSTRAP_ROLES=administrator
# Legacy shared-password /staff inbox is PREVIEW ONLY; not production access.
STAFF_PASSWORD=

# Both public forms notify this fixed mailbox, saving first.
# Private environment only. Never expose passwords through NEXT_PUBLIC_ or Git.
SMTP_HOST=mail.tocinvestment.co.tz
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@tocinvestment.co.tz
SMTP_PASS=
# IMAP 993 / POP3 995 are not needed for sending.

# Optional provider; disabled until processor, transfer, budget and data approval.
# Use a reviewed HTTPS OpenAI-compatible chat-completions endpoint.
AI_ENABLED=false
AI_DATA_PROCESSING_APPROVED=false
AI_API_URL=
AI_MODEL=
AI_API_KEY=
AI_DAILY_CALL_LIMIT=100

# Absolute executable path, e.g. clamscan. No shell command or extra arguments.
# No scanner => all uploads remain quarantined and cannot be downloaded/published.
MALWARE_SCANNER_PATH=

# Operational check thresholds; must be approved for the actual host.
OPS_MAX_WORKER_AGE_MINUTES=10
OPS_MAX_NOTIFICATION_AGE_MINUTES=30
