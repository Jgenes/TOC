# Keep true until TOC has approved company contacts, services and image rights.
NEXT_PUBLIC_PREVIEW_MODE=true
# Set after a production domain has been approved (no trailing slash).
# NEXT_PUBLIC_SITE_URL=https://your-approved-domain
# Run npm run setup:staff to create secure, local credentials.
STAFF_PASSWORD=
SESSION_SECRET=
# SQLite is for a single persistent Node server, not ephemeral serverless hosting.
DATABASE_PATH=./data/toc.sqlite

# Server-only email delivery for contact and quotation form notifications.
# Preview mode must be false (and the app rebuilt) to send automatic emails.
# Notifications go to info@tocinvestment.co.tz; the visitor is Reply-To only.
SMTP_HOST=mail.tocinvestment.co.tz
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@tocinvestment.co.tz
# Set the mailbox password privately in the hosting environment or .env.local.
# Never commit it or expose it through a NEXT_PUBLIC_ variable.
SMTP_PASS=
